{
  "name": "KibangouTV",
  "short_name": "KibangouTV",
  "description": "Plateforme de streaming HD - Films, Séries et Chaînes Live TV en direct",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0E1318",
  "theme_color": "#00C853",
  "lang": "fr-FR",
  "categories": ["entertainment", "video", "multimedia"],
  "icons": [
