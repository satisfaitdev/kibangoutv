{
  "version": 2,
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/api/proxy",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/get",
      "destination": "/api/get.js"
    },
    {
      "source": "/kibangou-addon/resolve",
      "destination": "/api/resolve.js"
    },
    {
      "source": "/resolve",
      "destination": "/api/resolve.js"
    },
    {
      "source": "/kibangou-addon",
      "destination": "/kibangou-addon/mhub-addon.json"
    },
    {
      "source": "/kibangou-addon/",
      "destination": "/kibangou-addon/mhub-addon.json"
    },
    {
      "source": "/live2/logo/:match*",
      "destination": "/api/proxy.js?url=https://vavoo.top/live2/logo/:match*"
    },
    {
      "source": "/live/logo/:match*",
      "destination": "/api/proxy.js?url=https://vavoo.top/live2/logo/:match*"
    },
    {
      "source": "/kibangou-addon/item/:match*",
      "destination": "/api/item.js"
    },
    {
      "source": "/item/:match*",
      "destination": "/api/item.js"
    },
    {
      "source": "/tmdb\\::match*",
      "destination": "/api/item.js"
    },
    {
      "source": "/imdb\\::match*",
      "destination": "/api/item.js"
    },
    {
      "source": "/kibangou-addon/source/:match*",
      "destination": "/api/source.js"
    },
    {
      "source": "/source/:match*",
      "destination": "/api/source.js"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
