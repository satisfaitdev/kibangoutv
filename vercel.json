{
  "version": 2,
  "functions": {
    "api/stream.js": {
      "includeFiles": "node_modules/ffmpeg-static/**",
      "maxDuration": 300
    },
    "api/catalog.js": {
      "includeFiles": "{kibangou-addon,french-addon,adult-addon}/catalog/**"
    }
  },
  "routes": [
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/",
        "Content-Type": "application/javascript; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/manifest\\.webmanifest$",
      "headers": {
        "Content-Type": "application/manifest+json; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS, HEAD",
        "Access-Control-Allow-Headers": "*"
      },
      "continue": true
    },
    {
      "src": "^/(kibangou-addon|french-addon|adult-addon)/catalog/([^/]+)/([^/?]+)$",
      "dest": "/api/catalog.js?addon=$1&type=$2&id=$3"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/download/?$",
      "dest": "/download.html"
    },
    {
      "src": "^/kibangoumboungoujustesatisfait0647307010002/?$",
      "dest": "/admin-kibangou.html"
    },
    {
      "src": "^/api/admin/?$",
      "dest": "/api/admin.js"
    },
    {
      "src": "^/api/telemetry/?$",
      "dest": "/api/telemetry.js"
    },
    {
      "src": "^/api/auth/google/callback$",
      "dest": "/api/auth.js?action=google_callback"
    },
    {
      "src": "^/api/auth/google$",
      "dest": "/api/auth.js?action=google"
    },
    {
      "src": "^/api/auth/?$",
      "dest": "/api/auth.js"
    },
    {
      "src": "^/api/proxy$",
      "dest": "/api/proxy.js"
    },
    {
      "src": "^/api/stream/h_([^/?]+)$",
      "dest": "/api/stream.js?h=$1"
    },
    {
      "src": "^/api/stream$",
      "dest": "/api/stream.js"
    },
    {
      "src": "^/get$",
      "dest": "/api/get.js"
    },
    {
      "src": "^/(?:kibangou-addon|french-addon|adult-addon)/resolve$",
      "dest": "/api/resolve.js"
    },
    {
      "src": "^/(?:api/)?resolve$",
      "dest": "/api/resolve.js"
    },
    {
      "src": "^/(?:kibangou-addon|french-addon|adult-addon)/client-fetch$",
      "dest": "/api/client-fetch.js"
    },
    {
      "src": "^/(?:api/)?client-fetch$",
      "dest": "/api/client-fetch.js"
    },
    {
      "src": "^/kibangou-addon/?$",
      "dest": "/kibangou-addon/mhub-addon.json"
    },
    {
      "src": "^/french-addon/?$",
      "dest": "/french-addon/mhub-addon.json"
    },
    {
      "src": "^/adult-addon/?$",
      "dest": "/adult-addon/mhub-addon.json"
    },
    {
      "src": "^/live2?/logo/(.*)$",
      "dest": "/api/proxy.js?url=https://vavoo.top/live2/logo/$1"
    },
    {
      "src": "^/(?:kibangou-addon|french-addon|adult-addon)/item/(.*)$",
      "dest": "/api/item.js"
    },
    {
      "src": "^/item/(.*)$",
      "dest": "/api/item.js"
    },
    {
      "src": "^/(?:tmdb|imdb):(.*)$",
      "dest": "/api/item.js"
    },
    {
      "src": "^/(?:kibangou-addon|french-addon|adult-addon)/source/(.*)$",
      "dest": "/api/source.js"
    },
    {
      "src": "^/source/(.*)$",
      "dest": "/api/source.js"
    }
  ]
}
